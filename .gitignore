# Dépendances (recréées par "npm install" — ne pas versionner)
node_modules/

# Données vivantes et sauvegardes locales de la pharmacie (propres à chaque serveur)
data/*.json

# Réglages locaux de Claude Code / de l'éditeur
.claude/settings.local.json

# Secrets locaux : ne doivent JAMAIS entrer dans l'historique. Le fichier
# n'existe pas aujourd'hui, mais un « git add . » au premier developpement local
# y embarquerait la cle Stripe et les identifiants PostgreSQL, dans un historique
# jusqu'ici propre.
.env
.env.*
!.env.example

# Tout fichier local de valeurs secretes. Il est ignore ici, mais il reste sur
# le disque, part dans les sauvegardes et se retrouve dans une archive envoyee
# par mail : le gestionnaire de mots de passe est fait pour ca, pas un dossier
# de code. Voir EXPLOITATION.md, « Ou vivent les secrets ».
*.local.*
secrets*
cles*
*.key
*.pem

# Divers
*.log
Thumbs.db
.DS_Store
